 \u003ctable role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"margin:0 auto 28px;\"\u003e\n        \u003ctr\u003e\n          \u003ctd align=\"center\" bgcolor=\"#070b10\" style=\"background-color:#070b10;border-radius:4px;\"\u003e\n            \u003c!--[if mso]\u003e\n            \u003cv:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" href=\"https://manager.theworldkeys.com/log-in\" style=\"height:48px;v-text-anchor:middle;width:240px;\" arcsize=\"8%\" stroke=\"f\" fillcolor=\"#070b10\"\u003e\n              \u003cw:anchorlock/\u003e\n              \u003ccenter style=\"color:#c9a96e;font-family:Segoe UI, Helvetica, Arial, sans-serif;font-size:13px;font-weight:600;letter-spacing:2px;\"\u003eACCESS DASHBOARD\u003c/center\u003e\n            \u003c/v:roundrect\u003e\n            \u003c![endif]--\u003e\n            \u003c!--[if !mso]\u003e\u003c!--\u003e\n            \u003ca href=\"https://manager.theworldkeys.com/log-in\" target=\"_blank\"\n               style=\"display:inline-block;padding:16px 36px;font-family:\u0027Jost\u0027, \u0027Segoe UI\u0027, \u0027Helvetica Neue\u0027, Helvetica, Arial, sans-serif;font-size:13px;font-weight:600;letter-spacing:2.5px;color:#c9a96e;text-decoration:none;background-color:#070b10;border-radius:4px;\"\u003e\n              ACCESS DASHBOARD\n            \u003c/a\u003e\n            \u003c!--\u003c![endif]--\u003e\n          \u003c/td\u003e\n        \u003c/tr\u003e\n      \u003c/table\u003e\n\n      \u003cp style=\"margin:0 0 18px;font-family:\u0027Jost\u0027, \u0027Segoe UI\u0027, \u0027Helvetica Neue\u0027, Helvetica, Arial, sans-serif;font-size:15.5px;line-height:1.75;color:#1d222b;\"\u003e\n        If the button above doesn\u0027t work, copy and paste the following link into your browser:\u003cbr/\u003e\n        \u003ca href=\"https://manager.theworldkeys.com/log-in\" target=\"_blank\" style=\"color:#9e7c48;word-break:break-all;\"\u003ehttps://manager.theworldkeys.com/log-in\u003c/a\u003e\n      \u003c/p\u003e\n\n      \u003cp style=\"margin:0 0 18px;font-family:\u0027Jost\u0027, \u0027Segoe UI\u0027, \u0027Helvetica Neue\u0027, Helvetica, Arial, sans-serif;font-size:15.5px;line-height:1.75;color:#1d222b;\"\u003e\n        Kind regards,\u003cbr/\u003e\n        The World Keys\u003cbr/\u003e\n        support@theworldkeys.com\n      \u003c/p\u003e\n    \u003c/td\u003e\u003c/tr\u003e\n\n  \n\n    \u003c!-- Footer --\u003e\n    \u003ctr\u003e\u003ctd align=\"center\" style=\"padding:20px 30px 6px;\"\u003e\n      \u003ctable role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\"\u003e\n        \u003ctr\u003e\n          \u003ctd style=\"padding:0 13px;\"\u003e\n            \u003ca href=\"https://wa.me/5521967841007\" target=\"_blank\" style=\"text-decoration:none;\"\u003e\n              \u003cimg src=\"https://theworldkeys-aria-whatsapp-agent.xis4ee.easypanel.host/icons/whatsapp.png\" width=\"26\" height=\"26\" alt=\"WhatsApp\" style=\"display:block;border:0;opacity:0.75;\" /\u003e\n            \u003c/a\u003e\n          \u003c/td\u003e\n          \u003ctd style=\"padding:0 13px;\"\u003e\n            \u003ca href=\"mailto:support@theworldkeys.com\" target=\"_blank\" style=\"text-decoration:none;\"\u003e\n              \u003cimg src=\"https://theworldkeys-aria-whatsapp-agent.xis4ee.easypanel.host/icons/email.png\" width=\"26\" height=\"26\" alt=\"Email\" style=\"display:block;border:0;opacity:0.75;\" /\u003e\n            \u003c/a\u003e\n          \u003c/td\u003e\n          \u003ctd style=\"padding:0 13px;\"\u003e\n            \u003ca href=\"https://theworldkeys.com/\" target=\"_blank\" style=\"text-decoration:none;\"\u003e\n              \u003cimg src=\"https://theworldkeys-aria-whatsapp-agent.xis4ee.easypanel.host/icons/site.png\" width=\"26\" height=\"26\" alt=\"Website\" style=\"display:block;border:0;opacity:0.75;\" /\u003e\n            \u003c/a\u003e\n          \u003c/td\u003e\n        \u003c/tr\u003e\n      \u003c/table\u003e\n    \u003c/td\u003e\u003c/tr\u003e\n\n    \u003ctr\u003e\u003ctd style=\"padding:14px 30px 8px;text-align:center;\"\u003e\n     \n      \u003cp style=\"margin:0;font-family:\u0027Jost\u0027, \u0027Segoe UI\u0027, \u0027Helvetica Neue\u0027, Helvetica, Arial, sans-serif;font-size:10.5px;letter-spacing:1.5px;color:#9a97a8;\"\u003e\n        THE\u0026nbsp;WORLD\u0026nbsp;KEYS\u0026nbsp;\u0026middot;\u0026nbsp;PARIS\u0026nbsp;\u0026middot;\u0026nbsp;2026\n      \u003c/p\u003e\n    \u003c/td\u003e\u003c/tr\u003e\n\n  \u003c/table\u003e\n\u003c/td\u003e\u003c/tr\u003e\n\u003c/table\u003e\n\u003c/body\u003e\n\u003c/html\u003e",
