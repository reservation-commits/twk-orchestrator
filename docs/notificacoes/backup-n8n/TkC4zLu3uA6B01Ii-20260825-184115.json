                                         "subject":  "Your Partnership Application Has Been Approved",
                                         "message":  "=\u003c!doctype html\u003e\n\u003chtml lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\"\u003e\n\u003chead\u003e\n\u003cmeta charset=\"utf-8\"/\u003e\n\u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/\u003e\n\u003cmeta name=\"color-scheme\" content=\"light\"/\u003e\n\u003cmeta name=\"supported-color-schemes\" content=\"light\"/\u003e\n\u003ctitle\u003eThe World Keys\u003c/title\u003e\n\u003c/head\u003e\n\u003cbody style=\"margin:0;padding:0;background-color:#ede9df;\"\u003e\n\u003c!-- preheader --\u003e\n\u003cdiv style=\"display:none;max-height:0;overflow:hidden;mso-hide:all;\"\u003e\n  Dear {{ $json.body.fullName.split(\u0027 \u0027)[0] }}, your partnership application has been approved.\u0026nbsp;\u0026zwnj;\u0026nbsp;\u0026zwnj;\u0026nbsp;\u0026zwnj;\u0026nbsp;\u0026zwnj;\n\u003c/div\u003e\n\n\u003ctable role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#ede9df\" style=\"background-color:#ede9df;\"\u003e\n\u003ctr\u003e\u003ctd align=\"center\" style=\"padding:28px 14px;\"\u003e\n\n  \u003ctable role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:600px;max-width:100%;\"\u003e\n\n    \u003c!-- Header --\u003e\n    \u003ctr\u003e\u003ctd bgcolor=\"#070b10\" style=\"background-color:#070b10;padding:30px 40px 26px;text-align:center;\"\u003e\n      \u003cdiv style=\"font-family:\u0027Cormorant Garamond\u0027, Georgia, \u0027Times New Roman\u0027, serif;font-size:27px;font-weight:400;letter-spacing:6px;color:#c9a96e;\"\u003eTHE\u0026nbsp;WORLD\u0026nbsp;KEYS\u003c/div\u003e\n      \u003cdiv style=\"font-family:\u0027Jost\u0027, \u0027Segoe UI\u0027, \u0027Helvetica Neue\u0027, Helvetica, Arial, sans-serif;font-size:10.5px;font-weight:400;letter-spacing:4px;color:#9a97a8;padding-top:9px;\"\u003ePARTNERS\u0026nbsp;\u0026amp;\u0026nbsp;RESTAURANTS\u003c/div\u003e\n    \u003c/td\u003e\u003c/tr\u003e\n\n    \u003c!-- Gold divider --\u003e\n    \u003ctr\u003e\u003ctd style=\"height:2px;line-height:2px;font-size:2px;background:linear-gradient(90deg,#9e7c48,#e4c990,#9e7c48);background-color:#c9a96e;\"\u003e\u0026nbsp;\u003c/td\u003e\u003c/tr\u003e\n\n    \u003c!-- Body --\u003e\n    \u003ctr\u003e\u003ctd bgcolor=\"#f7f4ef\" style=\"background-color:#f7f4ef;padding:38px 44px 22px;\"\u003e\n      \u003cp style=\"margin:0 0 18px;font-family:\u0027Jost\u0027, \u0027Segoe UI\u0027, \u0027Helvetica Neue\u0027, Helvetica, Arial, sans-serif;font-size:15.5px;line-height:1.75;color:#1d222b;\"\u003e\n        Dear {{ $json.body.fullName.split(\u0027 \u0027)[0] }},\n      \u003c/p\u003e\n\n      \u003cp style=\"margin:0 0 18px;font-family:\u0027Jost\u0027, \u0027Segoe UI\u0027, \u0027Helvetica Neue\u0027, Helvetica, Arial, sans-serif;font-size:15.5px;line-height:1.75;color:#1d222b;\"\u003e\n        We are pleased to inform you that the partnership application for\n        \u003cstrong style=\"font-weight:600;color:#1d222b;\"\u003e{{ $json.body.restaurantName }}\u003c/strong\u003e\n        has been \u003cstrong style=\"font-weight:600;color:#1d222b;\"\u003eapproved\u003c/strong\u003e.\n      \u003c/p\u003e\n\n      \u003cp style=\"margin:0 0 18px;font-family:\u0027Jost\u0027, \u0027Segoe UI\u0027, \u0027Helvetica Neue\u0027, Helvetica, Arial, sans-serif;font-size:15.5px;line-height:1.75;color:#1d222b;\"\u003e\n        You can now access the Partner Dashboard to manage reservations, guests, and your restaurant information.\n      \u003c/p\u003e\n\n      \u003cp style=\"margin:0 0 28px;font-family:\u0027Jost\u0027, \u0027Segoe UI\u0027, \u0027Helvetica Neue\u0027, Helvetica, Arial, sans-serif;font-size:15.5px;line-height:1.75;color:#1d222b;\"\u003e\n        Sign in using the email address\n        \u003cstrong style=\"font-weight:600;color:#1d222b;\"\u003e{{ $json.body.email }}\u003c/strong\u003e.\n      \u003c/p\u003e\n\n      \u003c!-- CTA --\u003e\n      \u003ctable role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"margin:0 auto 28px;\"\u003e\n        \u003ctr\u003e\n          \u003ctd align=\"center\" bgcolor=\"#070b10\" style=\"background-color:#070b10;border-radius:4px;\"\u003e\n            \u003c!--[if mso]\u003e\n            \u003cv:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" href=\"https://manager.theworldkeys.com/log-in\" style=\"height:48px;v-text-anchor:middle;width:240px;\" arcsize=\"8%\" stroke=\"f\" fillcolor=\"#070b10\"\u003e\n              \u003cw:anchorlock/\u003e\n              \u003ccenter style=\"color:#c9a96e;font-family:Segoe UI, Helvetica, Arial, sans-serif;font-size:13px;font-weight:600;letter-spacing:2px;\"\u003eACCESS DASHBOARD\u003c/center\u003e\n            \u003c/v:roundrect\u003e\n            \u003c![endif]--\u003e\n            \u003c!--[if !mso]\u003e\u003c!--\u003e\n            \u003ca href=\"https://manager.theworldkeys.com/log-in\" target=\"_blank\"\n               style=\"display:inline-block;padding:16px 36px;font-family:\u0027Jost\u0027, \u0027Segoe UI\u0027, \u0027Helvetica Neue\u0027, Helvetica, Arial, sans-serif;font-size:13px;font-weight:600;letter-spacing:2.5px;color:#c9a96e;text-decoration:none;background-color:#070b10;border-radius:4px;\"\u003e\n              ACCESS DASHBOARD\n            \u003c/a\u003e\n            \u003c!--\u003c![endif]--\u003e\n          \u003c/td\u003e\n        \u003c/tr\u003e\n      \u003c/table\u003e\n\n      \u003cp style=\"margin:0 0 18px;font-family:\u0027Jost\u0027, \u0027Segoe UI\u0027, \u0027Helvetica Neue\u0027, Helvetica, Arial, sans-serif;font-size:15.5px;line-height:1.75;color:#1d222b;\"\u003e\n        If the button above doesn\u0027t work, copy and paste the following link into your browser:\u003cbr/\u003e\n        \u003ca href=\"https://manager.theworldkeys.com/log-in\" target=\"_blank\" style=\"color:#9e7c48;word-break:break-all;\"\u003ehttps://manager.theworldkeys.com/log-in\u003c/a\u003e\n      \u003c/p\