    font-size:13px;\n          margin:0 0 12px;\n        \"\n      >\n        Reservation Details\n      </h3>\n\n      <p\n        style=\"\n          font-size:11px;\n          line-height:1.8;\n          color:#ccc;\n          margin:0;\n        \"\n      >\n        <strong>Guest:</strong>\n        {{ $('Webhook').item.json.body.user.name }}<br />\n\n        <strong>Email:</strong>\n        {{ $('Webhook').item.json.body.user.email }}<br />\n\n        <strong>Phone:</strong>\n        {{ $('Webhook').item.json.body.user.phone }}<br />\n\n        <strong>Date:</strong>\n        {{ $json.formattedDate }}<br />\n\n        <strong>Time:</strong>\n        {{ $json.formattedTime }}<br />\n\n        <strong>Guests:</strong>\n        {{ $json.formattedPeople }}<br />\n\n        <strong>Notes:</strong>\n        {{ $json.formattedDetails }}\n      </p>\n\n      <p\n        style=\"\n          font-size:9px;\n          color:#777;\n          margin:12px 0 0;\n        \"\n      >\n        Reservation ID:\n        {{ $('Webhook').item.json.body.reservation.reservation_code }}\n      </p>\n\n    </div>\n\n  </td>\n</tr>\n\n  <!-- Pending Notice -->\n  <tr>\n    <td style=\"padding:0 30px 20px; text-align:center;\">\n\n      <p\n        style=\"\n          color:#aaa;\n          font-size:10px;\n          line-height:1.6;\n          margin:0;\n        \"\n      >\n        Please review the updated reservation details.\n        This reservation is currently <strong style=\"color:#ce9e3c;\">pending confirmation</strong>.\n      </p>\n\n    </td>\n  </tr>\n\n  <!-- CTA -->\n  <tr>\n    <td style=\"padding:0 30px 35px; text-align:center;\">\n\n      <a\n        class=\"cta\"\n        href=\"https://manager.theworldkeys.com/admin/reservations\"\n        style=\"\n          background:#ce9e3c;\n          color:#fff;\n          border-radius:50px;\n          padding:10px 28px;\n          font-size:11px;\n          font-weight:bold;\n          text-decoration:none;\n          display:inline-block;\n        \"\n      >\n        Review Reservation\n      </a>\n\n    </td>\n  </tr>\n\n  <!-- Footer -->\n  <tr>\n    <td\n      style=\"\n        background:#1b1b1a;\n        padding:15px;\n        color:#888;\n        font-size:9px;\n        text-align:center;\n      \"\n    >\n\n      <strong style=\"color:#ce9e3c;\">\n        TheWorldKeys.com\n      </strong>\n\n      <br />\n\n      Your trusted partner for premium experiences\n\n      <br /><br />\n\n      <a\n        href=\"mailto:support@theworldkeys.com\"\n        style=\"color:#fff; text-decoration:none;\"\n      >\n        support@theworldkeys.com\n      </a>\n\n      <br />\n\n      Copyright ©2026 all rights reserved\n\n    </td>\n  </tr>\n\n</table>\n\n</body>\n</html>\n",
