 color:#000;\n               font-size:11px;\n               font-weight:700;\n               text-decoration:none;\n               padding:11px 25px;\n               display:inline-block;\n             \"\u003e\n            Reset Password\n          \u003c/a\u003e\n\n          \u003cp style=\"font-size:10px; color:#aaa; margin-top:18px; line-height:1.6;\"\u003e\n            If the button does not work, copy and paste the following link into your browser:\n          \u003c/p\u003e\n\n          \u003c!-- Fallback Link --\u003e\n          \u003ctable width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:10px;\"\u003e\n            \u003ctr\u003e\n              \u003ctd style=\"\n                background:#111;\n                border:1px solid #222;\n                border-radius:8px;\n                padding:12px;\n                word-break:break-all;\n                font-size:10px;\n                color:#ce9e3c;\n                font-family:monospace;\n                text-align:left;\n              \"\u003e\n                {{ $json.body.resetUrl }}\n              \u003c/td\u003e\n            \u003c/tr\u003e\n          \u003c/table\u003e\n\n        \u003c/td\u003e\n      \u003c/tr\u003e\n\n      \u003c!-- WhatsApp Support --\u003e\n      \u003ctr\u003e\n        \u003ctd align=\"center\" style=\"padding:0 2rem 1rem 2rem;\"\u003e\n\n          \u003ctable role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\u003e\n            \u003ctr\u003e\n              \u003ctd\n                align=\"center\"\n                style=\"\n                  border:1px solid #CE9E3C;\n                  border-radius:150px;\n                  padding-top:10px;\n                  padding-bottom:5px;\n                  padding-left:20px;\n                  padding-right:20px;\n                \"\n              \u003e\n\n                \u003ca href=\"https://wa.me/33781937270\"\n                   target=\"_blank\"\n                   style=\"\n      