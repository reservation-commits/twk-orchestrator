# MAESTRO Command Center — variáveis de ambiente (EasyPanel → Environment)
# ============================================================================
# 1) OBRIGATÓRIAS
# ============================================================================
# Em PRODUÇÃO sem CENTER_TOKEN a API responde 503 (fail-closed) — defina sempre.
CENTER_TOKEN=defina-uma-chave-forte-para-o-operador
# Token do canal de sincronização de estado (POST /api/ingest, Bearer)
INGEST_TOKEN=defina-outra-chave-forte

# ============================================================================
# 2) CÉREBRO EMBARCADO (processa Missões direto na Central)
# ============================================================================
ANTHROPIC_API_KEY=
MAESTRO_MODEL=claude-opus-4-8
MAESTRO_MODEL_COMPLEX=claude-fable-5
MAESTRO_EFFORT=high
MAESTRO_BRAIN=on
MAESTRO_MAX_MISSOES_DIA=20

# ============================================================================
# 3) URLs DOS AGENTES — acendem as luzes de saúde da frota
# ============================================================================
AGENT_CLAVIS_URL=https://theworldkeys-clavis-agent.xis4ee.easypanel.host
AGENT_ARIA_URL=https://theworldkeys-aria-whatsapp-agent.xis4ee.easypanel.host
AGENT_QUILL_URL=https://theworldkeys-quill-editorial-agent.xis4ee.easypanel.host
AGENT_ATLAS_URL=https://theworldkeys-atlas-finance-agent.xis4ee.easypanel.host
AGENT_DBA_URL=https://theworldkeys-database-agent-manager.xis4ee.easypanel.host
# Opcional: forçar o caminho de health de um agente (ex.: AGENT_QUILL_HEALTH_PATH=/api/healthz)

# ============================================================================
# 4) CREDENCIAIS DE LEITURA — é o que enche os dashboards de dados REAIS
#    Sem elas o painel diz "FALTA CREDENCIAL" (nunca inventa número).
#    Use o MESMO valor já configurado no serviço de cada agente.
# ============================================================================
# CLAVIS  → o mesmo valor de CLAVIS_API_TOKEN no serviço do CLAVIS
AGENT_CLAVIS_TOKEN=
# ARIA    → os mesmos DASHBOARD_USER / DASHBOARD_PASSWORD do serviço da Aria
AGENT_ARIA_USER=
AGENT_ARIA_PASSWORD=
# QUILL   → os mesmos BASIC_AUTH_USER / BASIC_AUTH_PASSWORD do admin do Quill
#           (exige o admin redeployado com app/api/kpis/route.ts)
AGENT_QUILL_USER=
AGENT_QUILL_PASSWORD=
# ATLAS   → uma chave de ATLAS_OPERATOR_KEYS (só o valor após "nome:") ou ATLAS_ADMIN_API_KEY
AGENT_ATLAS_KEY=
# DBA     → o mesmo DASHBOARD_TOKEN do twk-db-agent
#           (o serviço do DBA precisa ter DASHBOARD_PASSWORD definido também, senão responde 503)
AGENT_DBA_TOKEN=

# Ajustes finos do proxy de KPIs (opcionais)
KPI_CACHE_MS=60000
KPI_TIMEOUT_MS=7000

# ============================================================================
# 5) VIGIA DE DESEMPENHO (v3.4) — métricas + sentinelas + analista IA
#    Coleta horária dos KPIs → série histórica → achados na página Ações.
#    Nada aqui executa correção: aprovação é sempre humana, na Central.
# ============================================================================
# Intervalo da coleta de métricas (padrão: 1h)
METRICS_INTERVAL_MS=3600000
# Analista IA por domínio: on/off (usa a mesma ANTHROPIC_API_KEY do cérebro)
MAESTRO_ANALYST=on
# Modelo do analista (padrão: o modelo complexo do cérebro)
MAESTRO_ANALYST_MODEL=claude-fable-5
# Ciclo do analista em horas (padrão: 24) e teto de execuções/dia (freio de custo)
ANALYST_INTERVAL_H=24
ANALYST_MAX_PER_DAY=2

# ============================================================================
# 6) CONVERSA v4 — chat multimodal (usa a mesma ANTHROPIC_API_KEY do cérebro)
#    Sem a chave, as mensagens caem na fila do Orquestrador local (falhar alto).
# ============================================================================
# Teto diário de mensagens do chat (freio determinístico de custo; 0 = sem teto)
MAESTRO_MAX_CHAT_DIA=200
# Quantas mensagens do histórico da thread vão ao modelo a cada turno
MAESTRO_CHAT_HISTORICO=30
# Preços por modelo em CENTAVOS de USD por 1M tokens (JSON) — os padrões
# embutidos são ESTIMATIVA; confirme na tabela oficial da Anthropic e ajuste.
# MAESTRO_PRECOS={"claude-opus-4-8":{"in":1500,"out":7500,"cache_read":150},"claude-fable-5":{"in":3000,"out":15000,"cache_read":300}}
# Câmbio USD por EUR ×10000 para exibição do custo (padrão 10800 = 1,08 USD/EUR)
MAESTRO_USD_POR_EUR_E4=10800

# --- Ferramentas da frota (v4.1 "Regência") — padrão supervisor ---
# O cérebro consulta a frota DURANTE a conversa (somente leitura): KPIs, APIs de
# leitura dos agentes (mesmas credenciais da seção 4), estado e sub-especialistas.
MAESTRO_TOOLS=on
# Teto de rodadas de consulta por turno (evita loop; atingiu → avisa e pede "continue")
MAESTRO_MAX_TOOL_ROUNDS=8
# Timeout de cada consulta a agente (ms)
MAESTRO_TOOL_TIMEOUT_MS=12000

# --- Envio de e-mail (v4.2 "Execução") — aprovar no cartão = ENVIAR na hora ---
# O modelo confecciona; o clique do fundador dispara. Provedor (o 1º configurado vence):
# a) Webhook do n8n da casa: fluxo lá recebe {para, assunto, html} e entrega via Gmail/SMTP.
#    A Aria já usa o mesmo padrão (N8N_EMAIL_SEND_WEBHOOK) — pode apontar para o mesmo fluxo.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
# b) Ou Resend (https://resend.com): chave + remetente verificado
RESEND_API_KEY=
EMAIL_FROM=
# E-mail do fundador — destino de "me envie um teste"
MAESTRO_FOUNDER_EMAIL=reservation@theworldkeys.com

# --- Escrita no banco (v4.3 "Domínio") — aprovar cartão de correção = EXECUTAR via DBA ---
# Leitura livre (sql_leitura_dba) já funciona só com AGENT_DBA_TOKEN (seção 4). A ESCRITA é
# desligada por padrão e exige 3 chaves ao mesmo tempo (defesa em profundidade):
#   1) ligar o recurso                2) token DEDICADO de escrita (≠ do de leitura)
MAESTRO_DB_WRITE=off
AGENT_DBA_WRITE_TOKEN=
# O 3º fator é o clique do fundador no cartão (destrutivo pede confirmação tipada "CONFIRMAR").
# A execução real ocorre no DB Architect: transação + backup dos dados antigos + auditoria.
# ⚠ Antes de ligar: rotacionar a credencial exposta no repo do DBA e confirmar backup/PITR do Cloud SQL.
DB_EXEC_TIMEOUT_MS=20000

PORT=8787
STATE_DIR=/app/state
# --- Durabilidade (v4.4) — NÃO PERDER conversas no deploy ---
# SEED_DIR é a carga-semente dentro da imagem (o Dockerfile já define /app/seed).
# Na partida, o que faltar em /app/state é copiado de lá; dado vivo nunca é sobrescrito.
SEED_DIR=/app/seed
# ⚠ OBRIGATÓRIO no EasyPanel: montar um VOLUME PERSISTENTE em /app/state.
# Sem o volume, /app/state é reconstruído a cada deploy e as conversas SOMEM.
# (Mounts → Add Mount → Type: Volume · Name: maestro-state · Mount Path: /app/state)

# ============================================================================
# 7) REGÊNCIA (ADR-012) — os agentes reportam ao MAESTRO; o MAESTRO despacha ao fundador
#    Um ciclo diário (Despacho completo) + um horário (só alerta CRÍTICO novo, dedup 24h).
#    Nada aqui executa ação sensível: o Despacho pede decisões; a execução continua no Portão.
# ============================================================================
REGENCIA_ENABLED=off
# Hora (Europe/Paris) do Despacho diário
REGENCIA_HORA=8
# Leitura do banco pela Central (role twk_ro, SOMENTE LEITURA — nunca a credencial de dono)
DATABASE_URL_RO=
# Voz do MAESTRO no Despacho: modelo padrão e complexo (crítico / marca / legal / dinheiro)
# (o cérebro/analista das seções 2 e 5 ainda usam claude-fable-5; recomendado migrar para claude-fable-5-1)
# MAESTRO_MODEL=claude-opus-4-8
# MAESTRO_MODEL_COMPLEX=claude-fable-5-1
# MAESTRO_VOZ=on
# E-mail do Despacho: usa o provedor da seção "Envio de e-mail" (EMAIL_WEBHOOK_URL/TOKEN) e MAESTRO_FOUNDER_EMAIL.
# MAESTRO_DESPACHO_EMAIL=on
